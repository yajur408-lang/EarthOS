# Copy to backend/.env (never commit .env). The globe, susceptibility, rainfall trigger and backtest need none of these.
# Optional: enables Mapillary street-level imagery (free client token)
MAPILLARY_TOKEN=
FIRMS_MAP_KEY=
# Needed for the 30 m forest-loss watch and before/after checks (free NASA Earthdata token: urs.earthdata.nasa.gov)
EARTHDATA_TOKEN=
# Contact (email or URL) sent in the User-Agent to OpenStreetMap Nominatim, per their usage policy
NOMINATIM_CONTACT=
# Optional: self-hosted or commercial Nominatim-compatible endpoint
NOMINATIM_URL=
# Comma-separated list of frontends allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
